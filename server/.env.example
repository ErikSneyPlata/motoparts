# Application connection (Supabase session pooler or local PostgreSQL)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-0.YOUR_REGION.pooler.supabase.com:5432/postgres?schema=public"
# Direct PostgreSQL URL used by Prisma migrations
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?schema=public"
JWT_SECRET="replace-with-a-cryptographically-random-secret-of-at-least-32-characters"
CLIENT_ORIGIN="http://localhost:5173"
PORT="4000"
